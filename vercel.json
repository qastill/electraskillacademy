{
  "headers": [
    {
      "source": "/(.*)\\.(png|jpe?g|webp|gif|svg|mp4|woff2?|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/seo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/assets-protected/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin-sunarto.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/belajar-listrik", "destination": "/belajar-kelistrikan/", "permanent": true },
    { "source": "/kursus-listrik", "destination": "/kursus-listrik-online/", "permanent": true },
    { "source": "/kelas-listrik-online", "destination": "/kursus-listrik-online/", "permanent": true },
    { "source": "/platform-belajar-energi-terbaik", "destination": "/platform-belajar-energi/", "permanent": true },
    { "source": "/energi-terbarukan", "destination": "/belajar-energi-terbarukan/", "permanent": true },
    { "source": "/k3-listrik", "destination": "/pelatihan-k3-listrik/", "permanent": true },
    { "source": "/sertifikasi", "destination": "/sertifikasi-kompetensi-ketenagalistrikan/", "permanent": true },
    { "source": "/karir", "destination": "/karir-ketenagalistrikan/", "permanent": true }
  ]
}
